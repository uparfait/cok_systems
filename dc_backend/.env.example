# dc_backend environment variables - copy this file to .env and fill in
# real values. Every value below is intentionally left empty; only the
# comments describe what each one is for.

# Runtime environment: development | production
NODE_ENV=

# Port this service listens on
DC_PORT=

# Primary MongoDB connection string for this system's own database
# (projects, forms, templates, submissions)
conne_string=

# Name of the separate, read-only "cok" database (same Mongo cluster as the
# main backend) this service reads from to look up departments and users
COK_DB_NAME=

# Secret used to verify JWT access tokens - must match the main backend's
# JWT_SECRET so tokens issued by the main login flow are accepted here
JWT_SECRET=

# Secret used to verify JWT refresh tokens - must match the main backend's
# JWT_REFRESH_SECRET
JWT_REFRESH_SECRET=

# Secret used to sign/verify cookies
COOKIE_SECRET=

# The frontend's own URL - used for CORS and for links this service builds
# back to the app (e.g. public form links)
CLIENT_URL_SET=
