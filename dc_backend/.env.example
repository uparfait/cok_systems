# dc_backend environment variables
# Copy to .env and fill real values. Shares the same Mongo cluster/URI as the
# main backend, only the database name differs.

NODE_ENV=development
DC_PORT=8765

# Primary database for this system: forms, projects, submissions
conne_string=mongodb://localhost:27017/data_collection_system

# Read-only lookup database for departments and users (same Mongo instance
# that the main "cok" backend writes to)
COK_DB_NAME=cok

# Must match the main backend's JWT_SECRET so tokens issued by the main
# login flow are accepted here.
JWT_SECRET=cok-jwt-secret-2026

CLIENT_URL_SET=http://localhost:5173
