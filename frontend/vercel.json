{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/cok/api/v1/:path*",
      "destination": "https://cok-em-backend.onrender.com/cok/api/v1/:path*"
    },
    {
      "source": "/cok/api/:path*",
      "destination": "https://cok-bc.onrender.com/cok/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://cok-bc.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "https://cok-bc.onrender.com/cok/api/",
    "VITE_API_EVENT_URL": "https://cok-em-backend.onrender.com/"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}