# frontend environment variables - copy this file to .env and fill in real
# values. Every value below is intentionally left empty; only the comments
# describe what each one is for.

# Host the Vite dev server binds to (e.g. '0.0.0.0' to allow access from
# other devices on the network, not just localhost)
VITE_DEV_SERVER_HOST=

# Base URL of the main backend API
VITE_API_URL=

# Base URL of the event management backend API
VITE_API_EVENT_URL=

# Base URL for the websocket/live-updates connection
VITE_SOCKET_URL=
