
server {
    listen 80;
    server_name uat-ikaze.kigalicity.gov.rw uatps-ikaze.kigalicity.gov.rw uate-ikaze.kigalicity.gov.rw;

    # Let's Encrypt challenge path (if using host-based Certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# Main Frontend Application (Port 5713)
server {
    listen 443 ssl http2;
    server_name uat-ikaze.kigalicity.gov.rw;

    # SSL Certificates
    ssl_certificate /etc/nginx/certs/kigalicity.gov.rw.crt;
    ssl_certificate_key /etc/nginx/certs/kigalicity.gov.rw.key;

    # SSL Security Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    ssl_prefer_server_ciphers on;

    # Proxy to Docker frontend container on port 5713 (IP: 172.18.0.6)
    location / {
        proxy_pass http://172.18.0.6:5713;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Let's Encrypt challenge path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
}

# Backend API Service (Port 2026)
server {
    listen 443 ssl http2;
    server_name uatps-ikaze.kigalicity.gov.rw;

    # SSL Certificates
    ssl_certificate /etc/nginx/certs/kigalicity.gov.rw.crt;
    ssl_certificate_key /etc/nginx/certs/kigalicity.gov.rw.key;

    # SSL Security Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    ssl_prefer_server_ciphers on;

    # Proxy to Docker backend container on port 2027 (IP: 172.18.0.4)
    location / {
        proxy_pass http://172.18.0.4:2027;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Increase timeout for API requests
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Let's Encrypt challenge path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
}

