# em_backend (event management) environment variables - copy this file to
# .env and fill in real values. Every value below is intentionally left
# empty; only the comments describe what each one is for.

# Runtime environment: development | production
NODE_ENV=

# Port this service listens on
PORT=

# Base path this service's API routes are mounted under
API_BASE_PATH=

# API version prefix
API_VERSION=

# Allowed origin(s) for cross-origin requests (e.g. the frontend's URL, or
# * to allow any origin)
CORS_ORIGIN=

# The frontend's own URL - used for CORS and for links this service builds
# back to the app
FRONTEND_URL=

# Name of this service's own MongoDB database (event management data)
DATABASE_NAME2=

# MongoDB connection string for this service's own database
DATABASE_URL2=

# Secret used to verify JWT access tokens - must match the main backend's
# JWT_SECRET so tokens issued by the main login flow are accepted here
JWT_SECRET=

# Log output format (e.g. combined, dev)
LOG_FORMAT=

# Log verbosity level (e.g. info, debug, error)
LOG_LEVEL=

# Forces Node to prefer IPv4 when resolving hosts - works around DNS
# resolution issues on some hosting providers
NODEJS_PREFER_IPV4=

# Server timezone (e.g. Africa/Kigali)
TZ=

# Disables the optional native bufferutil addon for the ws WebSocket
# library - useful when that native module isn't available on the host
WS_NO_BUFFER_UTIL=

# Disables the optional native utf-8-validate addon for the ws WebSocket
# library - useful when that native module isn't available on the host
WS_NO_UTF_8_VALIDATE=

# Rate limiting window, in milliseconds (e.g. 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=

# Maximum number of requests allowed per client within the rate limit window
RATE_LIMIT_MAX_REQUESTS=

# SMTP host used to send outgoing email
EMAIL_HOST=

# SMTP port used to send outgoing email
EMAIL_PORT=

# SMTP account username
EMAIL_USER=

# SMTP account password
EMAIL_PASS=

# "From" name/address used on outgoing email
EMAIL_FROM=
