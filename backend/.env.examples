# backend (main "cok" system) environment variables - copy this file to
# .env and fill in real values. Every value below is intentionally left
# empty; only the comments describe what each one is for.

# Runtime environment: development | production
NODE_ENV=

# Port this service listens on
PORT=

# Primary MongoDB connection string for this system's own "cok" database
# (users, departments, and everything else the other services read from)
conne_string=

# Secret used to sign/verify JWT access tokens - the other services
# (dc_backend, em_backend) must use this exact same value so tokens issued
# by this login flow are accepted there too
JWT_SECRET=

# Secret used to sign/verify JWT refresh tokens
JWT_REFRESH_SECRET=

# Secret used to sign/verify cookies
COOKIE_SECRET=

# The frontend's own URL - used for CORS and for links this service builds
# back to the app
CLIENT_URL_SET=

# SMTP host used to send outgoing email
EMAIL_HOST=

# SMTP port used to send outgoing email
EMAIL_PORT=

# SMTP account username
EMAIL_USER=

# SMTP account password
EMAIL_PASS=

# "From" name/address used on outgoing email
EMAIL_FROM=

# Public VAPID key for Web Push notifications
VAPID_PUBLIC_KEY=

# Private VAPID key for Web Push notifications
VAPID_PRIVATE_KEY=

# Contact email associated with this service's Web Push (VAPID) identity
VAPID_MAILTO=
