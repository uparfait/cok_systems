# Copy this file to `.env` on the server and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
# Generate each secret with:  openssl rand -hex 32
# NEVER commit the real .env file.

# ---- MongoDB (the container) ----
MONGO_USER=cok_admin
MONGO_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# ---- Main backend (auth, service delivery, parking) ----
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
COOKIE_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- Public URL of the deployed site (your real domain) ----
FRONTEND_URL=https://ksesm.kigalicity.gov.rw
